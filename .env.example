# ==============================================================================
# GradeCalibrate - Environment Configuration
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# MongoDB Atlas Connection URI
# Replace with your MongoDB Atlas cluster connection string:
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:admin123@cluster0.mongodb.net/gradecalibrate?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=aust_cse_carnival_secret_gradecalibrate_2026

# Optional: Google Gemini API Key for Live AI Rubric & Script Assessment
GEMINI_API_KEY=

# Node Environment
NODE_ENV=development
